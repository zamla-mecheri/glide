# MongoDB connection string
# For MongoDB Atlas (cloud): Create cluster at https://cloud.mongodb.com, get connection string
# Example: mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/autoconnect?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/autoconnect?retryWrites=true&w=majority

# Server port (optional)
PORT=3000
